[Unit]
Description=Fr3d Agent
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=fr3d
Group=fr3d
WorkingDirectory=/opt/fr3d
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/fr3d/database.env
ExecStart=/opt/fr3d/.venv/bin/python -m server.Fr3dServer
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/fr3d/logs

[Install]
WantedBy=multi-user.target
