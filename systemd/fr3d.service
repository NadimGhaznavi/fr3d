[Unit]
Description=Fr3d LLM Server
After=network.target

[Service]
Type=simple
User=fr3d
Group=fr3d
WorkingDirectory=/opt/fr3d
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fr3d/.venv/bin/python -m server.Fr3dServer
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/fr3d/fr3dnet/journal

[Install]
WantedBy=multi-user.target
