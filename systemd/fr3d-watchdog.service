[Unit]
Description=Fr3d and LLM Watchdog
After=network.target llm-server.service fr3d-server.service
Wants=llm-server.service fr3d-server.service

[Service]
Type=simple
WorkingDirectory=/opt/fr3d
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fr3d/.venv/bin/python -m fr3d.server.Fr3dWatchdog
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/fr3d/logs

[Install]
WantedBy=multi-user.target
