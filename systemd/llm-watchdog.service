[Unit]
Description=Fr3d LLM Health Watchdog
After=network.target llm-server.service
Wants=llm-server.service

[Service]
Type=simple
WorkingDirectory=/opt/fr3d
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fr3d/.venv/bin/python -m server.LLMWatchdog
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/fr3d/logs

[Install]
WantedBy=multi-user.target
